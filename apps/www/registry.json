    {
      "name": "data-grid",
      "type": "registry:ui",
      "title": "Data Grid",
      "description": "A power-user data grid on TanStack Table v9 and shadcn/ui (Base UI): typed columns, sorting, faceted and typed filters, fuzzy search, pagination, selection and bulk actions, row actions, visibility, pinning, drag reorder, resizing, tree data, grouping with aggregation, virtualization, inline editing, cell selection with keyboard navigation and clipboard, export, density, row pinning, persisted and saved views.",
