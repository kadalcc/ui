{
  "name": "www",
  "version": "0.0.0",
  "private": true,
  "description": "ui.kadal.cc: the Kadal UI landing page, docs, playground and the shadcn registry (Astro + Starlight + React).",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 5400",
    "build": "bun run registry:build && bun run play:build && astro build",
    "preview": "astro preview --port 5400",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.json",
    "registry:build": "shadcn build registry.json -o public/r",
    "play:build": "bun scripts/build-playground.ts",
    "og": "bun scripts/og.ts",
    "test": "bun test src registry",
    "test:e2e": "playwright test",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.10",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "astro": "^7.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "livecodes": "^0.14.1",
    "lucide-react": "^1.70.0",
    "nuqs": "^2.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "shadcn": "^4.23.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "wrangler": "^4.105.0"
  }
}
