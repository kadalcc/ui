---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../data/site";
---

<Base title="Not found" description="This page doesn't exist." noindex>
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32">
    <div class="max-w-2xl">
      <p class="font-mono text-xs font-medium tracking-[0.14em] text-muted-foreground uppercase">404</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Lost at sea.</h1>
      <p class="mt-5 text-lg text-muted-foreground">
        This page doesn't exist, or it moved. The docs live under
        <code class="rounded bg-muted px-1 font-mono text-[0.9em]">/docs/</code>, and every registry item is under
        <code class="rounded bg-muted px-1 font-mono text-[0.9em]">/docs/data-grid/</code>.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/"
          class="inline-flex h-10 items-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90"
        >
          Home <Icon name="arrow-right" size={16} />
        </a>
        <a href="/docs/" class="inline-flex h-10 items-center rounded-lg border border-border px-4 text-sm font-medium hover:bg-muted">Docs</a>
        <a href="/playground/" class="inline-flex h-10 items-center rounded-lg border border-border px-4 text-sm font-medium hover:bg-muted">
          Playground
        </a>
      </div>
      <p class="mt-8 text-sm text-muted-foreground">
        A link on this site brought you here?
        <a href={SITE.newBug} rel="noopener" class="inline-flex items-center gap-1.5 underline underline-offset-4 hover:text-foreground">
          <Icon name="bug" size={14} /> Tell us on GitHub
        </a>
        and we'll fix it.
      </p>
    </div>
  </section>
</Base>
