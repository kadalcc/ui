---
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource/jetbrains-mono";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import KadalNetwork from "../components/KadalNetwork.astro";
import { SITE, POSTAL } from "../data/site";

interface Props {
  /** Page title without the product name; omit on the home page. */
  title?: string;
  pageTitle?: string;
  description?: string;
  /** /public path of a 1200×630 card. */
  og?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Hide the network cards (the playground, say). */
  bare?: boolean;
}
const {
  title,
  pageTitle,
  description = SITE.description,
  og = "/og/home.png",
  noindex = false,
  schema,
  bare = false,
} = Astro.props;
const fullTitle = pageTitle ?? (title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.category}`);
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogUrl = new URL(og, SITE.url).href;

const kadal = {
  "@type": "Organization",
  "@id": `${SITE.home}/#org`,
  name: SITE.tradingAs,
  url: SITE.home,
  email: SITE.email,
  address: POSTAL,
};
const software = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "@id": `${SITE.url}/#code`,
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  codeRepository: SITE.repo,
  programmingLanguage: "TypeScript",
  runtimePlatform: "React 19",
  license: "https://opensource.org/license/mit",
  image: ogUrl,
  author: kadal,
  publisher: kadal,
  isAccessibleForFree: true,
};
const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: ${SITE.category}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify([software, ...extra])} />
    <slot name="head" />
    <!-- The theme before first paint. The docs (Starlight) keep theirs under another key; one
         choice should hold across the whole site, so both are read and both are written. -->
    <script is:inline>
      try {
        const t = localStorage.getItem("starlight-theme") || localStorage.getItem("theme");
        const dark = t === "dark" || ((!t || t === "auto") && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      } catch {}
    </script>
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-100 focus:rounded-md focus:bg-background focus:px-3 focus:py-2 focus:ring-2 focus:ring-ring"
      >Skip to content</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    {!bare && <KadalNetwork />}
    <Footer />
  </body>
</html>
