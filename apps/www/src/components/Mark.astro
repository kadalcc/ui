---
/** The Kadal mark (the Horizon sun over the sea), from the brand kit, as a small tile. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<img
  src="/mark.svg"
  width={size}
  height={size}
  alt=""
  aria-hidden="true"
  class:list={["shrink-0 select-none", className]}
  style={`border-radius: ${Math.round(size * 0.234)}px`}
  draggable="false"
/>
