---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import { NAV, SITE } from "../data/site";

const path = Astro.url.pathname;
const current = (href: string) =>
  href === "/docs/" ? path.startsWith("/docs/") && !path.startsWith("/docs/data-grid/") : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-border/70 bg-background/80 backdrop-blur-md supports-[backdrop-filter]:bg-background/70"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight" aria-label={`${SITE.name}, home`}>
      <Mark size={28} />
      <span>Kadal <span class="font-normal text-muted-foreground">UI</span></span>
    </a>

    <nav class="ml-4 hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        NAV.map((n) => (
          <a
            href={n.href}
            aria-current={current(n.href) ? "page" : undefined}
            class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-[current=page]:bg-muted aria-[current=page]:text-foreground"
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <a
        href={SITE.sponsor}
        rel="noopener"
        class="hidden h-9 items-center gap-1.5 rounded-lg border border-border px-3 text-sm font-medium text-pink-600 transition-colors hover:bg-pink-500/10 sm:inline-flex dark:text-pink-400"
      >
        <Icon name="heart" size={16} /> Sponsor
      </a>
      <a
        href={SITE.discord}
        rel="noopener"
        aria-label="Join the Kadal Discord"
        class="hidden size-9 items-center justify-center rounded-lg border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground md:inline-flex"
      >
        <Icon name="discord" size={18} />
      </a>
      <a
        href={SITE.repo}
        rel="noopener"
        aria-label="Kadal UI on GitHub"
        class="inline-flex size-9 items-center justify-center rounded-lg border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
      >
        <Icon name="github" size={18} />
      </a>
      <button
        type="button"
        class="inline-flex size-9 items-center justify-center rounded-lg border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        aria-label="Switch between light and dark theme"
        data-theme-toggle
      >
        <Icon name="sun" size={18} class="dark:hidden" />
        <Icon name="moon" size={18} class="hidden dark:block" />
      </button>
      <a
        href="/docs/installation/"
        class="hidden h-9 items-center rounded-lg bg-primary px-3.5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 sm:inline-flex"
      >
        Get started
      </a>
      <details class="relative lg:hidden">
        <summary
          class="flex size-9 cursor-pointer list-none items-center justify-center rounded-lg border border-border text-muted-foreground hover:bg-muted hover:text-foreground [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Icon name="menu" size={18} />
        </summary>
        <div
          class="absolute right-0 mt-2 flex w-56 flex-col gap-0.5 rounded-lg border border-border bg-popover p-1.5 shadow-lg"
        >
          {
            NAV.map((n) => (
              <a href={n.href} class="rounded-md px-3 py-2 text-sm font-medium hover:bg-muted">
                {n.label}
              </a>
            ))
          }
          <a href="/docs/installation/" class="rounded-md px-3 py-2 text-sm font-medium hover:bg-muted">Get started</a>
          <a href={SITE.discord} rel="noopener" class="rounded-md px-3 py-2 text-sm font-medium hover:bg-muted">Discord</a>
          <a href={SITE.sponsor} rel="noopener" class="rounded-md px-3 py-2 text-sm font-medium hover:bg-muted">Sponsor</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    b.addEventListener("click", () => {
      const next = root.classList.contains("dark") ? "light" : "dark";
      root.classList.toggle("dark", next === "dark");
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
        localStorage.setItem("starlight-theme", next);
      } catch {}
    });
  }
  // Close the mobile menu on outside click or Escape.
  const menu = document.querySelector<HTMLDetailsElement>("header details");
  if (menu) {
    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") menu.open = false;
    });
  }
</script>
