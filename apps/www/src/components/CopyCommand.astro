---
/**
 * A one-line shell command with a copy button, in the reader's package manager. Every form is
 * highlighted at build time (Shiki, both themes) and the switcher shows one at a time.
 */
import { codeToHtml } from "shiki";
import Icon from "./Icon.astro";

interface Props {
  /** The npx form; pnpm/yarn/bun forms are derived. */
  command: string;
  class?: string;
  id?: string;
}
const { command, class: className, id } = Astro.props;
const forms = {
  npm: command,
  pnpm: command.replace(/^npx /, "pnpm dlx "),
  yarn: command.replace(/^npx /, "yarn dlx "),
  bun: command.replace(/^npx /, "bunx --bun "),
};
const highlighted = await Promise.all(
  (Object.keys(forms) as (keyof typeof forms)[]).map(async (pm) => {
    const html = await codeToHtml(forms[pm], {
      lang: "bash",
      themes: { light: "github-light", dark: "github-dark" },
      defaultColor: false,
    });
    // Only the tokens: the <code> below is the element.
    return [pm, html.replace(/^<pre[^>]*><code[^>]*>/, "").replace(/<\/code><\/pre>\s*$/, "")] as const;
  }),
);
---

<div
  class:list={[
    "group flex items-center gap-2 rounded-xl border border-border bg-muted/40 py-2 pr-2 pl-4 font-mono text-sm",
    className,
  ]}
  data-copy-command
  id={id}
>
  <span class="select-none text-muted-foreground" aria-hidden="true">$</span>
  <code class="code-shiki min-w-0 flex-1 overflow-x-auto whitespace-nowrap" data-cmd data-forms={JSON.stringify(forms)}>
    {highlighted.map(([pm, html]) => <span data-form={pm} hidden={pm !== "npm"} set:html={html} />)}
  </code>
  <div class="hidden items-center gap-0.5 rounded-md border border-border bg-background p-0.5 text-[11px] sm:flex" role="group" aria-label="Package manager">
    {
      (["npm", "pnpm", "yarn", "bun"] as const).map((pm) => (
        <button
          type="button"
          data-pm={pm}
          class="rounded px-1.5 py-0.5 font-sans text-muted-foreground hover:text-foreground aria-pressed:bg-muted aria-pressed:text-foreground"
          aria-pressed={pm === "npm"}
        >
          {pm}
        </button>
      ))
    }
  </div>
  <button
    type="button"
    class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
    aria-label="Copy command"
    data-copy
  >
    <Icon name="copy" size={15} class="[[data-copied]_&]:hidden" />
    <Icon name="check" size={15} class="hidden text-emerald-600 [[data-copied]_&]:block" />
  </button>
</div>

<script>
  const KEY = "kadal-ui:pm";
  const all = document.querySelectorAll<HTMLElement>("[data-copy-command]");
  const apply = (pm: string) => {
    for (const box of all) {
      const code = box.querySelector<HTMLElement>("[data-cmd]")!;
      const forms = JSON.parse(code.dataset.forms ?? "{}") as Record<string, string>;
      const shown = pm in forms ? pm : "npm";
      for (const form of code.querySelectorAll<HTMLElement>("[data-form]")) form.hidden = form.dataset.form !== shown;
      for (const b of box.querySelectorAll<HTMLButtonElement>("[data-pm]")) {
        b.setAttribute("aria-pressed", String(b.dataset.pm === pm));
      }
    }
  };
  let saved = "npm";
  try {
    saved = localStorage.getItem(KEY) || "npm";
  } catch {}
  apply(saved);
  for (const box of all) {
    for (const b of box.querySelectorAll<HTMLButtonElement>("[data-pm]")) {
      b.addEventListener("click", () => {
        const pm = b.dataset.pm ?? "npm";
        try {
          localStorage.setItem(KEY, pm);
        } catch {}
        apply(pm);
      });
    }
    box.querySelector<HTMLButtonElement>("[data-copy]")?.addEventListener("click", async () => {
      const code = box.querySelector<HTMLElement>("[data-cmd]");
      const forms = JSON.parse(code?.dataset.forms ?? "{}") as Record<string, string>;
      const shown = code?.querySelector<HTMLElement>("[data-form]:not([hidden])")?.dataset.form ?? "npm";
      const text = forms[shown] ?? code?.textContent?.trim() ?? "";
      try {
        await navigator.clipboard.writeText(text);
        box.dataset.copied = "";
        setTimeout(() => delete box.dataset.copied, 1500);
      } catch {}
    });
  }
</script>
