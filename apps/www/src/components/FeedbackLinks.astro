---
/**
 * Report a bug, request a feature, send feedback: the same three everywhere on the site, each a
 * GitHub template (issues for bugs and features, a Discussions category for feedback) so a reader
 * lands on a form that asks the right questions.
 */
import Icon from "./Icon.astro";
import { SITE } from "../data/site";

interface Props {
  /** Where the links are rendered, for layout: a stacked list or an inline row. */
  layout?: "list" | "row";
  class?: string;
}
const { layout = "list", class: className } = Astro.props;
const links = [
  { href: SITE.newBug, label: "Report a bug", icon: "bug" },
  { href: SITE.newFeature, label: "Request a feature", icon: "lightbulb" },
  { href: SITE.feedback, label: "Send feedback", icon: "message-square" },
] as const;
---

<ul
  class:list={[
    "text-sm",
    layout === "list" ? "flex flex-col gap-2" : "flex flex-wrap items-center gap-x-4 gap-y-1",
    className,
  ]}
  aria-label="Feedback"
  data-slot="feedback-links"
>
  {
    links.map((l) => (
      <li>
        <a
          href={l.href}
          rel="noopener"
          class="inline-flex items-center gap-2 text-muted-foreground transition-colors hover:text-foreground"
        >
          <Icon name={l.icon} size={16} /> {l.label}
        </a>
      </li>
    ))
  }
</ul>
